[Unit]
Description=Cascade personal AI (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
User=cascade
Group=cascade
WorkingDirectory=/opt/cascade
EnvironmentFile=/etc/cascade/cascade.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/cascade/.venv/bin/python -m uvicorn apps.api.main:app --host 127.0.0.1 --port 8500 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=3
MemoryHigh=150M
MemoryMax=250M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/cascade

[Install]
WantedBy=multi-user.target
